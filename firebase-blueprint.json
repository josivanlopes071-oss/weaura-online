{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "Core user information and social stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "level": { "type": "integer" },
        "xp": { "type": "integer", "description": "Experience points" },
        "coins": { "type": "integer" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "displayId": { "type": "integer", "description": "Sequential user ID starting from 1" },
        "isBanned": { "type": "boolean" },
        "status": { "type": "string", "enum": ["online", "offline", "away"] },
        "followers": { "type": "array", "items": { "type": "string" } },
        "following": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role"]
    },
    "room": {
      "title": "Chat Room",
      "description": "Voice and text chat rooms",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "activeSpeakers": { "type": "array", "items": { "type": "string" } },
        "slots": { "type": "object" },
        "isLocked": { "type": "boolean" },
        "category": { "type": "string", "enum": ["Amizade", "Música", "Jogos", "Namoro", "Chat", "Anime", "Livre"] },
        "participantLimit": { "type": "number" },
        "password": { "type": "string" },
        "theme": { "type": "string" },
        "neonColor": { "type": "string" },
        "stageLayout": { "type": "string" },
        "allowFreeMic": { "type": "boolean" },
        "moderators": { "type": "array", "items": { "type": "string" } },
        "mutedUsers": { "type": "array", "items": { "type": "string" } },
        "coHosts": { "type": "array", "items": { "type": "string" } },
        "coverURL": { "type": "string" },
        "hostInfo": {
          "type": "object",
          "properties": {
            "displayName": { "type": "string" },
            "photoURL": { "type": "string" }
          }
        },
        "lastActive": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["public", "private"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "message": {
      "title": "Message",
      "description": "Room messages",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "gift", "system"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "private_chat": {
      "title": "Private Chat",
      "description": "One-to-one conversation between users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "system_announcement": {
      "title": "System Announcement",
      "description": "Admin broadcast messages visible to all users",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "adminName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "adminName", "createdAt"]
    },
    "admin_audit_log": {
      "title": "Admin Audit Log",
      "description": "Logs of admin operations for transparency and tracking",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning", "success", "critical"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "adminEmail", "action", "type", "timestamp"]
    },
    "checkers_match": {
      "title": "Checkers Match",
      "description": "Competitive checkers match with automated matchmaking and betting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorPhoto": { "type": "string" },
        "player1": { "type": "string" },
        "player2": { "type": "string" },
        "player2Name": { "type": "string" },
        "player2Photo": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting_peer", "playing", "ended"] },
        "betAmount": { "type": "integer" },
        "winnerId": { "type": "string" },
        "winnerName": { "type": "string" },
        "reason": { "type": "string", "enum": ["victory", "abandoned", "draw"] },
        "turn": { "type": "string", "enum": ["player1", "player2"] },
        "board": { "type": "array", "items": { "type": "integer" } },
        "potClaimed": { "type": "boolean" },
        "player1AuraActive": { "type": "boolean" },
        "player2AuraActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastMoveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorId", "player1", "status", "betAmount", "board"]
    },
    "tictactoe_match": {
      "title": "Tic Tac Toe Match",
      "description": "Multiplayer Tic-Tac-Toe match with betting",
      "type": "object",
      "properties": {
        "player1": { "type": "string" },
        "player1Name": { "type": "string" },
        "player1Photo": { "type": "string" },
        "player2": { "type": "string" },
        "player2Name": { "type": "string" },
        "player2Photo": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "playing", "ended"] },
        "betAmount": { "type": "integer" },
        "board": { "type": "array", "items": { "type": "string" } },
        "turn": { "type": "string" },
        "winner": { "type": "string" },
        "winningLine": { "type": "array", "items": { "type": "integer" } },
        "potClaimedByWinner": { "type": "boolean" },
        "refundedUsers": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["player1", "status", "betAmount", "board", "turn"]
    },
    "gift_transaction": {
      "title": "Gift Transaction",
      "description": "A record of a gift sent from one user to another",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "giftId": { "type": "string" },
        "giftName": { "type": "string" },
        "giftIcon": { "type": "string" },
        "price": { "type": "integer" },
        "quantity": { "type": "integer" },
        "totalPrice": { "type": "integer" },
        "auraGained": { "type": "integer" },
        "coinsGained": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "roomId": { "type": "string" },
        "chatId": { "type": "string" }
      },
      "required": ["senderId", "receiverId", "giftId", "quantity", "totalPrice", "auraGained", "createdAt"]
    },
    "custom_profile_frame": {
      "title": "Custom Profile Frame",
      "description": "Administrator custom uploaded profile frame",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "price": { "type": "integer" },
        "rarity": { "type": "string", "enum": ["Lendário", "Épico", "Raro", "Comum"] },
        "noProcessing": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "imageUrl", "rarity", "price", "createdAt"]
    }
  },
  "firestore": {
    "/custom_profile_frames/{frameId}": {
      "schema": "custom_profile_frame",
      "description": "Custom frames added by administrator"
    },
    "/gift_transactions/{transactionId}": {
      "schema": "gift_transaction",
      "description": "History of all sent gifts"
    },
    "/tictactoe_matches/{matchId}": {
      "schema": "tictactoe_match",
      "description": "1v1 competitive Tic-Tac-Toe matches with coin betting"
    },
    "/checkers_matches/{matchId}": {
      "schema": "checkers_match",
      "description": "1v1 competitive checkers matches with coin betting"
    },
    "/system_announcements/{announcementId}": {
      "schema": "system_announcement",
      "description": "Global admin announcements"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "admin_audit_log",
      "description": "Trace audit logs of admin holographic workspace actions"
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/rooms/{roomId}": {
      "schema": "room",
      "description": "Chat rooms"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "message",
      "description": "Messages inside a room"
    },
    "/private_chats/{chatId}": {
      "schema": "private_chat",
      "description": "One-to-one conversations"
    },
    "/private_chats/{chatId}/messages/{messageId}": {
      "schema": "message",
      "description": "Private messages"
    }
  }
}
