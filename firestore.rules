rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'josivanlopes071@gmail.com',
        'manoeldasilva631kejr@gmail.com'
      ];
    }

    // Helper to check for admin role
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    // Helper to check if user is not banned
    function isNotBanned() {
      return isSignedIn() && (
        isSuperAdmin() ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == false ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('bannedUntil', request.time) < request.time)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. System Counters (MUST be accessible for user creation)
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && (!resource.data.get('isBanned', false) || isSuperAdmin())) || 
                    isAdmin() ||
                    (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']));

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow write: if isNotBanned();
      }
    }

    // 3. App Content
    function isValidRoom(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.members is list && data.members.size() <= 100 &&
             data.activeSpeakers is list && data.activeSpeakers.size() <= 100 &&
             data.slots is map &&
             data.hostInfo is map &&
             data.category is string &&
             data.neonColor is string && data.neonColor.size() <= 20 &&
             data.createdAt == request.time &&
             data.lastActive == request.time;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      
      allow create: if isNotBanned() && isValidRoom(request.resource.data) && (
        request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'hostInfo', 'members', 'activeSpeakers', 'slots', 'type', 'category', 'participantLimit', 'isLocked', 'password', 'theme', 'neonColor', 'stageLayout', 'allowFreeMic', 'moderators', 'mutedUsers', 'coHosts', 'coverURL', 'lastActive', 'createdAt'])
      );

      allow update: if isNotBanned() && (
        // Owner/Admin can update everything
        (request.auth.uid == resource.data.ownerId || isAdmin()) ||
        // Members can join/leave or update speakers
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'activeSpeakers', 'slots', 'lastActive']))
      );

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isNotBanned();
      }
      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow create: if isNotBanned();
      }
    }

    match /private_chats/{chatId} {
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isNotBanned();

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && isNotBanned();
      }
    }

    // 4. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
