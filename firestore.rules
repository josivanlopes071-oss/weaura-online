rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && (
               request.auth.token.email.lower() == 'josivanlopes071@gmail.com' ||
               request.auth.token.email.lower() == 'manoeldasilva631kejr@gmail.com'
             );
    }

    // Helper to check for admin role
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    // Helper to check if user is not banned
    function isNotBanned() {
      return isSignedIn() && (
        isSuperAdmin() ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == false
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // 1. System Counters (MUST be accessible for user creation)
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && (isNotBanned() || isSuperAdmin())) || 
                    isAdmin() ||
                    (isSignedIn() && isNotBanned() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'updatedAt'])) ||
                    (isSignedIn() && isNotBanned() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aura', 'auraLevel', 'coins', 'updatedAt']));

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow write: if isNotBanned();
      }
    }

    // 3. App Content
    function isValidRoom(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.members is list && data.members.size() <= 100 &&
             data.activeSpeakers is list && data.activeSpeakers.size() <= 100 &&
             data.slots is map &&
             data.hostInfo is map &&
             data.category is string &&
             data.neonColor is string && data.neonColor.size() <= 20 &&
             data.createdAt == request.time &&
             data.lastActive == request.time;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      
      allow create: if isNotBanned() && isValidRoom(request.resource.data) && (
        request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'hostInfo', 'members', 'activeSpeakers', 'slots', 'type', 'category', 'participantLimit', 'isLocked', 'password', 'theme', 'neonColor', 'stageLayout', 'allowFreeMic', 'moderators', 'mutedUsers', 'coHosts', 'coverURL', 'lastActive', 'createdAt'])
      );

      allow update: if isNotBanned() && (
        // Owner/Admin/Moderator can update everything
        (request.auth.uid == resource.data.get('ownerId', '') || (resource.data.get('moderators', []) != null && request.auth.uid in resource.data.get('moderators', [])) || isAdmin()) ||
        // Members can join/leave, update speakers, update donor gift rankings, or request speech
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'activeSpeakers', 'slots', 'lastActive', 'giftRank', 'voicePeerIds', 'speakRequests']))
      );

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.get('ownerId', ''));

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isNotBanned();
        allow delete: if isSignedIn() && isNotBanned();
      }
      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow create: if isNotBanned();
      }
    }

    match /private_chats/{chatId} {
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.get('participants', []));
      allow create: if isNotBanned();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.get('participants', []));
        allow create: if isNotBanned() && (request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.get('participants', []));
        allow update: if isNotBanned() && (request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.get('participants', []));
      }
    }

    // 4. Checkers Matches Game System
    function isValidCheckersMatch(data) {
      return data.creatorId is string &&
             data.creatorName is string &&
             data.player1 is string &&
             data.status is string &&
             (data.betAmount is int || data.betAmount is float) && data.betAmount >= 50 && data.betAmount <= 1000 &&
             data.board is list && data.board.size() == 64 &&
             data.potClaimed is bool;
    }

    match /checkers_matches/{matchId} {
      allow read: if isSignedIn();
      
      allow create: if isNotBanned() && 
                    isValidId(matchId) &&
                    isValidCheckersMatch(request.resource.data) && 
                    request.resource.data.creatorId == request.auth.uid &&
                    request.resource.data.player1 == request.auth.uid &&
                    request.resource.data.status == 'waiting_peer' &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.keys().hasAll(['id', 'creatorId', 'creatorName', 'creatorPhoto', 'player1', 'player2', 'player2Name', 'player2Photo', 'status', 'betAmount', 'winnerId', 'winnerName', 'reason', 'turn', 'board', 'potClaimed', 'player1AuraActive', 'player2AuraActive', 'createdAt']) &&
                    request.resource.data.keys().size() == 19;

      allow update: if isNotBanned() && 
                    isValidCheckersMatch(request.resource.data) && (
                      // Action 1: Joiner joining the match
                      (
                        resource.data.get('player2', null) == null && 
                        request.resource.data.get('player2', '') == request.auth.uid &&
                        request.resource.data.get('status', '') == 'playing' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player2', 'player2Name', 'player2Photo', 'status', 'turn', 'board', 'lastMoveAt'])
                      ) ||
                      // Action 2: Active player taking a move turn or forfeiting
                      (
                        resource.data.get('status', '') == 'playing' &&
                        (
                          // Option A: Active player taking a move turn (must be their turn)
                          (
                            resource.data.get('turn', '') == (resource.data.get('player1', '') == request.auth.uid ? 'player1' : 'player2') &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['board', 'turn', 'status', 'winnerId', 'winnerName', 'reason', 'lastMoveAt'])
                          ) ||
                          // Option B: Any of the playing players forfeiting at any point
                          (
                            (request.auth.uid == resource.data.get('player1', '') || request.auth.uid == resource.data.get('player2', '')) &&
                            request.resource.data.get('status', '') == 'ended' &&
                            request.resource.data.get('reason', '') == 'abandoned' &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerId', 'winnerName', 'reason', 'lastMoveAt'])
                          )
                        )
                      ) ||
                      // Action 3: Winner claiming their pot
                      (
                        resource.data.get('status', '') == 'ended' &&
                        resource.data.get('winnerId', '') == request.auth.uid &&
                        resource.data.get('potClaimed', false) == false &&
                        request.resource.data.get('potClaimed', false) == true &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['potClaimed'])
                      )
                    );

      allow delete: if isSignedIn() && resource.data.get('creatorId', '') == request.auth.uid && resource.data.get('status', '') == 'waiting_peer';
    }

    // 4.5 Tic-Tac-Toe Game System
    function isValidTictactoeMatch(data) {
      return data.player1 is string &&
             data.status is string &&
             (data.betAmount is int || data.betAmount is float) && data.betAmount >= 0 && data.betAmount <= 1000 &&
             data.board is list && data.board.size() == 9 &&
             data.turn is string;
    }

    match /tictactoe_matches/{matchId} {
      allow read: if isSignedIn();
      
      allow create: if isNotBanned() && 
                    isValidId(matchId) &&
                    isValidTictactoeMatch(request.resource.data) && 
                    request.resource.data.player1 == request.auth.uid &&
                    request.resource.data.status == 'waiting' &&
                    request.resource.data.turn == request.auth.uid &&
                    request.resource.data.keys().hasAll(['player1', 'player1Name', 'player1Photo', 'player2', 'player2Name', 'player2Photo', 'status', 'betAmount', 'board', 'turn', 'winner', 'winningLine', 'updatedAt', 'potClaimedByWinner', 'refundedUsers']) &&
                    request.resource.data.keys().size() == 15;

      allow update: if isNotBanned() && 
                    isValidTictactoeMatch(request.resource.data) && (
                      // Action 1: Joiner joining the match
                      (
                        resource.data.get('player2', null) == null && 
                        request.resource.data.get('player2', '') == request.auth.uid &&
                        request.resource.data.get('status', '') == 'playing' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player2', 'player2Name', 'player2Photo', 'status', 'updatedAt'])
                      ) ||
                      // Action 2: Player taking a move turn
                      (
                        resource.data.get('status', '') == 'playing' &&
                        resource.data.get('turn', '') == request.auth.uid &&
                        request.resource.data.get('status', '') == 'playing' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['board', 'turn', 'updatedAt'])
                      ) ||
                      // Action 3: Ending/concluding game (win/draw/forfeit)
                      (
                        (request.auth.uid == resource.data.get('player1', '') || request.auth.uid == resource.data.get('player2', '')) &&
                        request.resource.data.get('status', '') == 'ended' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['board', 'winner', 'winningLine', 'status', 'updatedAt'])
                      ) ||
                      // Action 4: Claiming pot or refunding
                      (
                        // If winner is claiming
                        (
                          resource.data.get('status', '') == 'ended' &&
                          resource.data.get('winner', '') == request.auth.uid &&
                          resource.data.get('potClaimedByWinner', false) == false &&
                          request.resource.data.get('potClaimedByWinner', false) == true &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['potClaimedByWinner'])
                        ) ||
                        // If refunding in case of raw draw
                        (
                          resource.data.get('status', '') == 'ended' &&
                          resource.data.get('winner', '') == 'Draw' &&
                          !(request.auth.uid in resource.data.get('refundedUsers', [])) &&
                          (request.auth.uid in request.resource.data.get('refundedUsers', [])) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundedUsers'])
                        )
                      )
                    );

      allow delete: if isSignedIn() && resource.data.get('player1', '') == request.auth.uid && resource.data.get('status', '') == 'waiting';
    }

    // Gift Transactions History
    match /gift_transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isNotBanned() && request.resource.data.get('senderId', '') == request.auth.uid;
    }

    // Profile Visits Track
    match /profile_visits/{visitId} {
      allow read: if isSignedIn();
      allow create: if isNotBanned() && request.resource.data.get('visitorId', '') == request.auth.uid;
    }

    // Feedback Contributions Track
    match /contributions/{contribId} {
      allow read: if isAdmin();
      allow create: if isNotBanned() && request.resource.data.get('userId', '') == request.auth.uid;
    }

    // 5. Admin system & audit tables
    match /system_announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isNotBanned();
    }

    match /custom_profile_frames/{frameId} {
      allow read, write: if isSignedIn();
    }

    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin() && isNotBanned();
      allow update, delete: if false;
    }

    // 4.6 Posts (Momentos / Cantinho) Rules
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update: if isNotBanned();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 4.7 Stories (Momentos) Rules
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update: if isNotBanned();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 5. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
